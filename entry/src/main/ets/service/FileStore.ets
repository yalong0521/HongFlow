import { fileIo } from '@kit.CoreFileKit';
import { common } from '@kit.AbilityKit';
import { util } from '@kit.ArkTS';
import { resourceManager } from '@kit.LocalizationKit';
import { ProfileInfo, SavedSettings, VpnRequest, VpnSnapshot } from '../model/AppModels';

export class FileStore {
  readonly root: string;
  private resources: resourceManager.ResourceManager;

  constructor(context: common.Context) {
    this.root = context.filesDir + '/hongflow';
    this.resources = context.resourceManager;
    for (const directory of [this.root, this.root + '/profiles', this.root + '/core']) {
      if (!fileIo.accessSync(directory)) {
        try {
          fileIo.mkdirSync(directory, true);
        } catch (error) {
          // The UI and VPN extension can initialize the same sandbox concurrently.
          if (!fileIo.accessSync(directory)) {
            throw error as Error;
          }
        }
      }
    }
  }

  profilePath(id: string): string {
    // Profile identities are generated by the app, never taken from remote filenames.
    if (!/^[0-9a-f-]+$/i.test(id)) {
      throw new Error('配置标识无效');
    }
    return this.root + '/profiles/' + id + '.yaml';
  }

  readText(path: string): string {
    try {
      return fileIo.readTextSync(path);
    } catch (error) {
      throw error as Error;
    }
  }

  writeText(path: string, content: string): void {
    const bytes = new util.TextEncoder().encodeInto(content);
    this.writeBytes(path, bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength));
  }

  seedCoreResources(): void {
    for (const name of ['GEOIP.metadb', 'GEOSITE.dat', 'GEOIP.dat']) {
      const path = this.root + '/core/' + name;
      try {
        if (fileIo.accessSync(path) && fileIo.statSync(path).size > 0) {
          continue;
        }
        // A subscription can depend on Geo rules at parse time. Seed the same
        // databases as FlClash before startup instead of requiring a download.
        const bytes = this.resources.getRawFileContentSync('geodata/' + name);
        this.writeBytes(path, bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength));
      } catch (error) {
        throw new Error('初始化规则数据失败: ' + (error as Error).message);
      }
    }
  }

  private writeBytes(path: string, content: ArrayBuffer): void {
    const temporary = path + '.' + util.generateRandomUUID() + '.tmp';
    try {
      const file = fileIo.openSync(temporary, fileIo.OpenMode.CREATE | fileIo.OpenMode.WRITE_ONLY);
      try {
        if (fileIo.writeSync(file.fd, content) !== content.byteLength) {
          throw new Error('保存配置时发生不完整写入');
        }
        fileIo.fsyncSync(file.fd);
      } finally {
        fileIo.closeSync(file);
      }
      fileIo.renameSync(temporary, path);
    } catch (error) {
      try {
        if (fileIo.accessSync(temporary)) {
          fileIo.unlinkSync(temporary);
        }
      } catch (_) {
      }
      throw error as Error;
    }
  }

  readProfiles(): ProfileInfo[] {
    const path = this.root + '/profiles.json';
    try {
      if (!fileIo.accessSync(path)) {
        return [];
      }
      return JSON.parse(this.readText(path)) as ProfileInfo[];
    } catch (error) {
      throw new Error('读取订阅列表失败: ' + (error as Error).message);
    }
  }

  writeProfiles(profiles: ProfileInfo[]): void {
    this.writeText(this.root + '/profiles.json', JSON.stringify(profiles));
  }

  readSettings(): SavedSettings {
    const path = this.root + '/settings.json';
    try {
      if (!fileIo.accessSync(path)) {
        return new SavedSettings();
      }
      return JSON.parse(this.readText(path)) as SavedSettings;
    } catch (error) {
      throw new Error('读取设置失败: ' + (error as Error).message);
    }
  }

  writeSettings(settings: SavedSettings): void {
    this.writeText(this.root + '/settings.json', JSON.stringify(settings));
  }

  readSnapshot(): VpnSnapshot {
    const path = this.root + '/status.json';
    try {
      if (!fileIo.accessSync(path)) {
        return new VpnSnapshot();
      }
      return JSON.parse(this.readText(path)) as VpnSnapshot;
    } catch (_) {
      return new VpnSnapshot();
    }
  }

  writeSnapshot(snapshot: VpnSnapshot): void {
    snapshot.updatedAt = Date.now();
    this.writeText(this.root + '/status.json', JSON.stringify(snapshot));
  }

  readRequest(): VpnRequest | undefined {
    const path = this.root + '/request.json';
    try {
      if (!fileIo.accessSync(path)) {
        return undefined;
      }
      return JSON.parse(this.readText(path)) as VpnRequest;
    } catch (_) {
      return undefined;
    }
  }

  writeRequest(request: VpnRequest): void {
    this.writeText(this.root + '/request.json', JSON.stringify(request));
  }
}
