diff --git a/config/hongflow_validate.go b/config/hongflow_validate.go
new file mode 100644
index 0000000..e05336a
--- /dev/null
+++ b/config/hongflow_validate.go
@@ -0,0 +1,152 @@
+package config
+
+import (
+	"fmt"
+
+	"github.com/metacubex/mihomo/adapter/outboundgroup"
+	"github.com/metacubex/mihomo/adapter/provider"
+	"github.com/metacubex/mihomo/common/structure"
+	C "github.com/metacubex/mihomo/constant"
+	RC "github.com/metacubex/mihomo/rules/common"
+	"github.com/metacubex/mihomo/rules/logic"
+)
+
+// ValidateProfileReferences checks names, local group/provider options and routing
+// references before HongFlow replaces a saved profile. It deliberately does not
+// construct protocol clients, load Geo data, fetch providers or publish global state.
+// Resource availability and protocol-specific rule payloads remain startup checks.
+func ValidateProfileReferences(raw *RawConfig) error {
+	proxies := map[string]bool{
+		"DIRECT": true, "REJECT": true, "REJECT-DROP": true,
+		"COMPATIBLE": true, "PASS": true, "PASS-RULE": true,
+	}
+	var proxyNames, providerNames []string
+	for name := range raw.ProxyProvider {
+		providerNames = append(providerNames, name)
+	}
+	proxyDecoder := structure.NewDecoder(structure.Option{TagName: "proxy", WeaklyTypedInput: true})
+	for index, mapping := range raw.Proxy {
+		identity := struct {
+			Name string `proxy:"name"`
+		}{}
+		if err := proxyDecoder.Decode(mapping, &identity); err != nil {
+			return fmt.Errorf("proxy %d: %w", index, err)
+		}
+		name := identity.Name
+		if name == "" {
+			return fmt.Errorf("proxy %d: missing name", index)
+		}
+		if _, exists := proxies[name]; exists {
+			return fmt.Errorf("proxy %s is the duplicate name", name)
+		}
+		proxies[name] = true
+		proxyNames = append(proxyNames, name)
+	}
+	groups := make([]outboundgroup.GroupCommonOption, len(raw.ProxyGroup))
+	for index, mapping := range raw.ProxyGroup {
+		group, err := outboundgroup.ValidateProxyGroup(mapping, proxyNames, providerNames)
+		if err != nil {
+			return fmt.Errorf("proxy group[%d]: %w", index, err)
+		}
+		groups[index] = group
+		if _, exists := proxies[group.Name]; exists {
+			return fmt.Errorf("proxy group %s: the duplicate name", group.Name)
+		}
+		proxies[group.Name] = false
+	}
+	// The upstream DAG checker sorts its input; validation must not reorder it.
+	if err := proxyGroupsDagSort(append([]map[string]any(nil), raw.ProxyGroup...)); err != nil {
+		return err
+	}
+	for name, mapping := range raw.ProxyProvider {
+		if name == provider.ReservedName {
+			return fmt.Errorf("can not defined a provider called `%s`", name)
+		}
+		if err := provider.ValidateProxyProvider(name, mapping); err != nil {
+			return fmt.Errorf("parse proxy provider %s error: %w", name, err)
+		}
+	}
+	for _, group := range groups {
+		// Only groups with effective proxies create a compatible provider of
+		// their own; a use-only group may legally share a provider's name.
+		if _, exists := raw.ProxyProvider[group.Name]; exists && len(group.Proxies) != 0 {
+			return fmt.Errorf("proxy group %s: duplicate provider name", group.Name)
+		}
+		for _, name := range group.Proxies {
+			if _, exists := proxies[name]; !exists {
+				return fmt.Errorf("proxy group %s: '%s' not found", group.Name, name)
+			}
+		}
+		for _, name := range group.Use {
+			if _, exists := raw.ProxyProvider[name]; !exists {
+				return fmt.Errorf("proxy group %s: provider '%s' not found", group.Name, name)
+			}
+		}
+		if group.EmptyFallback != "" && !proxies[group.EmptyFallback] {
+			return fmt.Errorf("proxy group %s: empty fallback proxy '%s' not found", group.Name, group.EmptyFallback)
+		}
+	}
+	// Mihomo adds GLOBAL when a profile does not define its own group.
+	proxies["GLOBAL"] = false
+	subRules := make(map[string][]C.Rule, len(raw.SubRules))
+	for name := range raw.SubRules {
+		if name == "" {
+			return fmt.Errorf("sub-rule name is empty")
+		}
+		subRules[name] = nil
+	}
+	// Reuse the upstream logical-rule parser to find RULE-SET references nested
+	// inside AND/OR/NOT/SUB-RULE, without constructing Geo or provider matchers.
+	var parseReference RC.ParseRuleFunc
+	parseReference = func(tp, payload, target string, params []string, _ map[string][]C.Rule) (C.Rule, error) {
+		switch tp {
+		case "SUB-RULE":
+			return logic.NewSubRule(payload, target, subRules, parseReference)
+		case "AND":
+			return logic.NewAND(payload, target, parseReference)
+		case "OR":
+			return logic.NewOR(payload, target, parseReference)
+		case "NOT":
+			return logic.NewNOT(payload, target, parseReference)
+		case "RULE-SET":
+			if _, exists := raw.RuleProvider[payload]; !exists {
+				return nil, fmt.Errorf("rule set [%s] not found", payload)
+			}
+		}
+		return RC.NewMatch(target), nil
+	}
+	checkRules := func(lines []string, location string) ([]C.Rule, error) {
+		result := make([]C.Rule, 0, len(lines))
+		for index, line := range lines {
+			tp, payload, target, params := RC.ParseRulePayload(line, true)
+			if target == "" {
+				return nil, fmt.Errorf("%s[%d]: format invalid", location, index)
+			}
+			if tp == "SUB-RULE" {
+				if _, exists := subRules[target]; !exists {
+					return nil, fmt.Errorf("%s[%d]: sub-rule [%s] not found", location, index, target)
+				}
+			} else if _, exists := proxies[target]; !exists {
+				return nil, fmt.Errorf("%s[%d]: proxy [%s] not found", location, index, target)
+			}
+			rule, err := parseReference(tp, payload, target, params, subRules)
+			if err != nil {
+				return nil, fmt.Errorf("%s[%d]: %w", location, index, err)
+			}
+			result = append(result, rule)
+		}
+		return result, nil
+	}
+	for name, lines := range raw.SubRules {
+		parsed, err := checkRules(lines, "sub-rules["+name+"]")
+		if err != nil {
+			return err
+		}
+		subRules[name] = parsed
+	}
+	if err := verifySubRule(subRules); err != nil {
+		return err
+	}
+	_, err := checkRules(raw.Rule, "rules")
+	return err
+}
